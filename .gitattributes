# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.cs text eol=crlf
*.xaml text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.iss text eol=crlf
# 批处理必须是 CRLF：cmd.exe 解析 LF-only 的 .cmd 会吃字符/标签错乱
*.cmd text eol=crlf
*.bat text eol=crlf
*.md text eol=lf

# Binary files
*.png binary
*.jpg binary
*.ico binary
*.exe binary
*.dll binary
