<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <AssemblyName>LlamaDSH_Launcher</AssemblyName>
    <RootNamespace>LlamaDSH_Launcher</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <!-- 必须保留：App.xaml.cs 的 [LibraryImport] 由源生成器产出 unsafe 代码（SYSLIB1062 / CS0227），
         删掉会让整个项目编译失败。除非把 P/Invoke 全部改回 [DllImport]，否则不要移除。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <EmbeddedResource Include="Resources\conversion_kit.zip" />
    <EmbeddedResource Include="Resources\llama_params.yml" />
    <Content Include="gputemp\gputemp.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <EmbeddedResource Include="Resources\GameAccessProbe.ps1" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="System.Management" Version="[8.0.0,9.0.0)" />
    <PackageReference Include="System.Drawing.Common" Version="[8.0.0,9.0.0)" />
    <PackageReference Include="YamlDotNet" Version="[16.0.0,17.0.0)" />
  </ItemGroup>

</Project>
