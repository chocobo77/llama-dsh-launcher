<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <AssemblyName>LlamaDSH_Launcher</AssemblyName>
    <RootNamespace>LlamaDSH_Launcher</RootNamespace>
    <Nullable>enable</Nullable>
    <!-- 代码库存量 80+ 处风格级可空性告警(CS86xx), 一次性补齐注解风险大;
         保留 Nullable 语义但暂不告警, 后续按文件逐步收紧后从 NoWarn 移除 -->
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8619;CS8620;CS8625;CS8629</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <!-- 必须保留：App.xaml.cs 的 [LibraryImport] 由源生成器产出 unsafe 代码（SYSLIB1062 / CS0227），
         删掉会让整个项目编译失败。除非把 P/Invoke 全部改回 [DllImport]，否则不要移除。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 版本单一来源是 installer.iss 的 MyAppVersion；一键封包.cmd 会把同一个 x.y.z 同步到这里。
         缺了这几行，exe 文件属性和 `cli status` 报的版本会永远停在 1.0.0.0，排障时对不上安装包。 -->
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Product>DeepSeek Harness &amp; Llama 启动器</Product>
    <Company>LlamaDSH</Company>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <EmbeddedResource Include="Resources\conversion_kit.zip" />
    <EmbeddedResource Include="Resources\llama_params.yml" />
    <Content Include="gputemp\gputemp.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <EmbeddedResource Include="Resources\GameAccessProbe.ps1" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="System.Management" Version="[9.0.0,10.0.0)" />
    <PackageReference Include="System.Drawing.Common" Version="[8.0.0,9.0.0)" />
    <PackageReference Include="YamlDotNet" Version="[16.0.0,17.0.0)" />
    <!-- 跨厂商硬件传感成熟方案(FanControl/Sidebar Diagnostics 同源): NVIDIA/AMD/Intel 温度/功率/风扇/频率/负载 -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="[0.9.4,1.0.0)" />
  </ItemGroup>

</Project>
