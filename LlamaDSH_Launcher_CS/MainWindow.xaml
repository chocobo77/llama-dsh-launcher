                  <StackPanel>
                    <DockPanel><TextBlock DockPanel.Dock="Right" Name="GenSub" Text="" FontSize="10" FontFamily="Consolas" Foreground="#8e979f" VerticalAlignment="Center" /><TextBlock Text="生成速度" Foreground="#c7cdd3" FontSize="12" /></DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Name="GenVal" Text="—" Foreground="#7cd7f7" FontSize="26" FontWeight="Bold" FontFamily="Consolas" /><TextBlock Text="tok/s" Foreground="#8e979f" FontSize="11" VerticalAlignment="Bottom" Margin="4,0,0,4" /></StackPanel>
                    <Grid Name="GenBar" Height="4" Margin="0,8,0,0" Background="#1d2226"><Border Name="GenBarFill" HorizontalAlignment="Left" Width="0" Background="#34d399" CornerRadius="2" /></Grid>
                    <Grid Margin="0,2,0,0"><TextBlock Text="0" FontSize="9" Foreground="#8e979f" FontFamily="Consolas" /><TextBlock Name="GenBarMax" Text="" HorizontalAlignment="Right" FontSize="9" Foreground="#8e979f" FontFamily="Consolas" /></Grid>
                    <svc:SparkChart x:Name="GenSpark" Margin="0,6,0,0" />
                    <TextBlock Name="GenFoot" Text="" FontSize="10" FontFamily="Consolas" Foreground="#8e979f" Margin="0,4,0,0" />
                  </StackPanel>
                </Border>
                <Border Background="#161a1d" CornerRadius="10" Padding="14" Margin="4" BorderBrush="#2a3036" BorderThickness="1">
                  <StackPanel>
                    <DockPanel><TextBlock DockPanel.Dock="Right" Name="PfSub" Text="" FontSize="10" FontFamily="Consolas" Foreground="#8e979f" VerticalAlignment="Center" /><TextBlock Text="预填充速度" Foreground="#c7cdd3" FontSize="12" /></DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Name="PfVal" Text="—" Foreground="#4ade80" FontSize="26" FontWeight="Bold" FontFamily="Consolas" /><TextBlock Text="tok/s" Foreground="#8e979f" FontSize="11" VerticalAlignment="Bottom" Margin="4,0,0,4" /></StackPanel>
                    <Grid Name="PfBar" Height="4" Margin="0,8,0,0" Background="#1d2226"><Border Name="PfBarFill" HorizontalAlignment="Left" Width="0" Background="#4ade80" CornerRadius="2" /></Grid>
                    <Grid Margin="0,2,0,0"><TextBlock Text="0" FontSize="9" Foreground="#8e979f" FontFamily="Consolas" /><TextBlock Name="PfBarMax" Text="" HorizontalAlignment="Right" FontSize="9" Foreground="#8e979f" FontFamily="Consolas" /></Grid>
                    <svc:SparkChart x:Name="PfSpark" Margin="0,6,0,0" />
                    <TextBlock Name="PfFoot" Text="" FontSize="10" FontFamily="Consolas" Foreground="#8e979f" Margin="0,4,0,0" />
                  </StackPanel>
                </Border>
                <Border Background="#161a1d" CornerRadius="10" Padding="14" Margin="4" BorderBrush="#2a3036" BorderThickness="1">
                  <StackPanel>
                    <DockPanel><Border DockPanel.Dock="Right" Name="CtxBadge" Visibility="Collapsed" Background="#2eff5a6e" CornerRadius="5" Padding="6,1" VerticalAlignment="Center"><TextBlock Text="接近上限" FontSize="10" Foreground="#ff8a98" /></Border><TextBlock Text="上下文占用" Foreground="#c7cdd3" FontSize="12" /></DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Name="CtxVal" Text="—" Foreground="#eef1f3" FontSize="26" FontWeight="Bold" FontFamily="Consolas" /><TextBlock Text="tokens" Foreground="#8e979f" FontSize="11" VerticalAlignment="Bottom" Margin="4,0,0,4" /></StackPanel>
                    <Grid Name="CtxBar" Height="4" Margin="0,8,0,0" Background="#1d2226"><Border Name="CtxBarFill" HorizontalAlignment="Left" Width="0" Background="#34d399" CornerRadius="2" /></Grid>
                    <Grid Margin="0,2,0,0"><TextBlock Text="0" FontSize="9" Foreground="#8e979f" FontFamily="Consolas" /><TextBlock Name="CtxMax" Text="—" HorizontalAlignment="Right" FontSize="9" Foreground="#8e979f" FontFamily="Consolas" /></Grid>
                    <svc:SparkChart x:Name="CtxSpark" Margin="0,6,0,0" />
                    <TextBlock Name="CtxSub" Text="" FontSize="10" FontFamily="Consolas" Foreground="#8e979f" Margin="0,4,0,0" />
                  </StackPanel>
                </Border>
                <Border Background="#161a1d" CornerRadius="10" Padding="14" Margin="4" BorderBrush="#2a3036" BorderThickness="1">
                  <StackPanel>
                    <TextBlock Text="MTP 接受率" Foreground="#c7cdd3" FontSize="12" />
