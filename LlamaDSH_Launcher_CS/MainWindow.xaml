                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Name="Stat3Label" Text="上下文占用" Foreground="#8e979f" FontSize="11" />
                        <StackPanel Orientation="Horizontal"><TextBlock Name="Stat3Val" Text="—" Foreground="#eef1f3" FontSize="22" FontWeight="Bold" FontFamily="Consolas" /><TextBlock Name="Stat3Unit" Text="" Foreground="#8e979f" FontSize="10" VerticalAlignment="Bottom" Margin="3,0,0,5" /></StackPanel>
                      </StackPanel>
                    </Grid>
                    <Grid Name="MonBar" Height="5" Margin="0,10,0,0" Background="#1d2226">
                      <Border Name="MonBarFill" HorizontalAlignment="Left" Width="0" CornerRadius="2" Background="#34d399" />
                    </Grid>
                    <Grid Margin="0,5,0,0">
                      <TextBlock Name="MonPhaseLabel" Text="等待请求" Foreground="#eef1f3" FontSize="12" />
                      <TextBlock Name="MonPhaseDetail" HorizontalAlignment="Right" Foreground="#8e979f" FontSize="12" Text="" />
                    </Grid>
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#161a1d" CornerRadius="10" Padding="16,12" Margin="4,0,0,0" BorderBrush="#2a3036" BorderThickness="1">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                      <TextBlock DockPanel.Dock="Right" Name="MonEventCount" Text="0 / 200" Foreground="#8e979f" FontSize="11" VerticalAlignment="Center" />
                      <TextBlock Text="事件流" Foreground="#eef1f3" FontSize="14" FontWeight="Bold" />
                    </DockPanel>
                    <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto">
                      <ItemsControl Name="MonEventFeed" FontFamily="Consolas" FontSize="11">
