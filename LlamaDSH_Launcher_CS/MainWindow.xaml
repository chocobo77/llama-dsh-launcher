            <Button Grid.Row="0" Grid.Column="1" Name="BtnLlamaStop" Content="⏹ 停止 Llama" Background="#da3633" Foreground="#FFFFFFFF" Height="30" FontSize="12" IsEnabled="False" Click="StopLlama_Click" />
