                <ComboBoxItem Content="固定值 (GB)" />
              </local:NoScrollComboBox>
              <TextBox Name="TxtVramBreakerVal" Width="48" Text="90" VerticalAlignment="Center" FontSize="11" Margin="0,0,8,0" ToolTip="阈值：百分比模式填 0-100，GB 模式填小数如 20.0" />
              <TextBlock Name="LblVramBreaker" Text="" Foreground="#8b949e" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
          <Border Grid.Column="1" Background="#30363d" Width="1" />
          <!-- DSH 区块 -->
          <Grid Grid.Column="2" Margin="14,0,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="122" />
              <ColumnDefinition Width="122" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button Grid.Row="0" Grid.Column="0" Name="BtnDshStart" Content="▶ 启动 DSH" Background="#238636" Foreground="#FFFFFFFF" Height="30" FontSize="12" Margin="0,0,10,8" HorizontalAlignment="Left" Click="StartDsh_Click" />
            <Button Grid.Row="0" Grid.Column="1" Name="BtnDshStop" Content="⏹ 停止 DSH" Background="#da3633" Foreground="#FFFFFFFF" Height="30" FontSize="12" IsEnabled="False" Click="StopDsh_Click" />
            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Name="LblDshStatus" Text="● 已停止" Foreground="#8b949e" FontSize="12" Margin="0,0,0,8" />
            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal">
              <Button Name="BtnRebuildDsh" Content="🔨 重建 DSH" Height="30" FontSize="12" Margin="0,0,10,0" Click="RebuildDsh_Click" ToolTip="全量重建 DSH 编译产物 (pnpm clean + build:lib + vite)。若 DSH 正在运行会先停止；重建完成后自动做兼容性检查并启动 DSH。" />
              <Button Name="BtnOpenDsh" Content="🌐 打开 Web" Height="30" FontSize="12" IsEnabled="False" Click="OpenDsh_Click" />
            </StackPanel>
          </Grid>
        </Grid>
      </GroupBox>

      <!-- ── 监测/日志双标签页：标签1 效仿 Strata Monitor 设计（状态卡 + 指标卡带迷你历史曲线 + 数据来源徽标），标签2 原运行日志 ── -->
      <TabControl Name="MainTabs" Grid.Row="1" Margin="0,6,0,0" Background="Transparent" BorderBrush="#30363d" BorderThickness="1" SelectionChanged="MainTabs_SelectionChanged">
        <TabControl.Resources>
          <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#8b949e" />
            <Setter Property="Background" Value="#161b22" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                  <Border Name="TabBd" Background="{TemplateBinding Background}" BorderBrush="#30363d" BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" Margin="0,0,2,0" Padding="{TemplateBinding Padding}">
                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="TabBd" Property="Background" Value="#0d1117" />
                      <Setter Property="Foreground" Value="#e6edf3" />
                      <Setter Property="FontWeight" Value="Bold" />
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="TabBd" Property="Background" Value="#1f2937" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
            <Style TargetType="GridViewColumnHeader">
              <Setter Property="Background" Value="#1d2226" />
              <Setter Property="Foreground" Value="#8e979f" />
              <Setter Property="BorderBrush" Value="#30363d" />
              <Setter Property="BorderThickness" Value="0,0,0,1" />
              <Setter Property="Padding" Value="6,4" />
              <Setter Property="FontWeight" Value="Normal" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="GridViewColumnHeader">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                      <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="ReqItem" TargetType="ListViewItem">
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="Foreground" Value="#c7cdd3" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="Padding" Value="0,1" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Background" Value="#1d2226" />
                </Trigger>
              </Style.Triggers>
            </Style>
        </TabControl.Resources>
        <TabItem Header="📊 监测" IsSelected="True">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Name="MonitorRoot" Margin="8">

              <!-- ═══ 摘要条(llama-lens MetricsPanel strip): label+大数值+unit 单元格 ═══ -->
              <Border Background="#161a1d" CornerRadius="10" Padding="14,10" BorderBrush="#2a3036" BorderThickness="1">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Name="BtnSnapshot" Content="📷" Click="Snapshot_Click" ToolTip="保存监测页截图为 PNG" Padding="8,3" VerticalAlignment="Center" />
                  <WrapPanel>
                    <StackPanel Margin="0,0,22,0">
                      <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#7cd7f7" VerticalAlignment="Center" /><TextBlock Text=" 生成速度" Foreground="#8e979f" FontSize="11" /></StackPanel>
                      <StackPanel Orientation="Horizontal"><TextBlock Name="StripGenVal" Text="—" Foreground="#eef1f3" FontSize="19" FontWeight="Bold" FontFamily="Consolas" /><TextBlock Text="tok/s" Foreground="#8e979f" FontSize="10" VerticalAlignment="Bottom" Margin="3,0,0,3" /></StackPanel>
                    </StackPanel>
                    <StackPanel Margin="0,0,22,0">
                      <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#4ade80" VerticalAlignment="Center" /><TextBlock Text=" 预填充速度" Foreground="#8e979f" FontSize="11" /></StackPanel>
                      <StackPanel Orientation="Horizontal"><TextBlock Name="StripPfVal" Text="—" Foreground="#eef1f3" FontSize="19" FontWeight="Bold" FontFamily="Consolas" /><TextBlock Text="tok/s" Foreground="#8e979f" FontSize="10" VerticalAlignment="Bottom" Margin="3,0,0,3" /></StackPanel>
                    </StackPanel>
                    <StackPanel Margin="0,0,22,0">
                      <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#f5b53d" VerticalAlignment="Center" /><TextBlock Text=" 上下文" Foreground="#8e979f" FontSize="11" /></StackPanel>
                      <StackPanel Orientation="Horizontal"><TextBlock Name="StripCtxVal" Text="—" Foreground="#eef1f3" FontSize="19" FontWeight="Bold" FontFamily="Consolas" /><TextBlock Name="StripCtxUnit" Text="tokens" Foreground="#8e979f" FontSize="10" VerticalAlignment="Bottom" Margin="3,0,0,3" /></StackPanel>
                    </StackPanel>
                    <Border Width="1" Background="#2a3036" Margin="0,2,22,2" />
                    <StackPanel Margin="0,0,22,0">
                      <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#f0883e" VerticalAlignment="Center" /><TextBlock Text=" GPU 利用率" Foreground="#8e979f" FontSize="11" /></StackPanel>
                      <StackPanel Orientation="Horizontal"><TextBlock Name="StripGpuVal" Text="—" Foreground="#eef1f3" FontSize="19" FontWeight="Bold" FontFamily="Consolas" /><TextBlock Text="%" Foreground="#8e979f" FontSize="10" VerticalAlignment="Bottom" Margin="3,0,0,3" /></StackPanel>
                    </StackPanel>
                    <StackPanel Margin="0,0,22,0">
                      <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#f0883e" VerticalAlignment="Center" /><TextBlock Text=" 显存" Foreground="#8e979f" FontSize="11" /></StackPanel>
                      <StackPanel Orientation="Horizontal"><TextBlock Name="StripMemVal" Text="—" Foreground="#eef1f3" FontSize="19" FontWeight="Bold" FontFamily="Consolas" /><TextBlock Name="StripMemUnit" Text="GB" Foreground="#8e979f" FontSize="10" VerticalAlignment="Bottom" Margin="3,0,0,3" /></StackPanel>
                    </StackPanel>
                    <StackPanel Margin="0,0,22,0">
                      <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#f0883e" VerticalAlignment="Center" /><TextBlock Text=" GPU 温度" Foreground="#8e979f" FontSize="11" /></StackPanel>
                      <StackPanel Orientation="Horizontal"><TextBlock Name="StripTempVal" Text="—" Foreground="#eef1f3" FontSize="19" FontWeight="Bold" FontFamily="Consolas" /><TextBlock Text="°C" Foreground="#8e979f" FontSize="10" VerticalAlignment="Bottom" Margin="3,0,0,3" /></StackPanel>
