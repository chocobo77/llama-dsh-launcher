                      <Grid Width="92" Height="92" HorizontalAlignment="Center">
                        <Ellipse Stroke="#1d2226" StrokeThickness="8" StrokeDashCap="Round" StrokeDashArray="24.74 100" RenderTransformOrigin="0.5,0.5">
