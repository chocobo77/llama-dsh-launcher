                        </Ellipse>
                        <Ellipse Name="MtpRing" Stroke="#7cd7f7" StrokeThickness="8" StrokeDashCap="Round" StrokeDashArray="0.02 100" Opacity="0" RenderTransformOrigin="0.5,0.5">
