                        </Ellipse>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                          <TextBlock Name="MtpVal" Text="—" FontSize="17" FontWeight="Bold" Foreground="#eef1f3" HorizontalAlignment="Center" />
                          <TextBlock Text="acceptance" FontSize="8" Foreground="#8e979f" HorizontalAlignment="Center" />
                        </StackPanel>
                      </Grid>
                    </Grid>
                    <svc:SparkChart x:Name="MtpSpark" Margin="0,6,0,0" />
                    <TextBlock Name="MtpSub" Text="启用投机解码后显示" FontSize="10" FontFamily="Consolas" Foreground="#8e979f" Margin="0,4,0,0" HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>
