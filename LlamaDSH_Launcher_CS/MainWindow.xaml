                          <DataTemplate>
                            <TextBlock Text="{Binding Line}" Foreground="{Binding LevelColor}" TextWrapping="Wrap" Margin="0,1" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </StackPanel>
                </Border>
              </Grid>

              <!-- ═══ 系统资源 ═══ -->
              <Grid Margin="0,12,0,0">
                <TextBlock Text="系统资源" Foreground="#eef1f3" FontSize="14" FontWeight="Bold" />
              </Grid>
              <Grid Margin="0,6,0,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="#161a1d" CornerRadius="10" Padding="16,12" Margin="0,0,4,0" BorderBrush="#2a3036" BorderThickness="1">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                      <TextBlock DockPanel.Dock="Right" Name="CpuHeadSub" Text="" FontSize="11" FontFamily="Consolas" Foreground="#8e979f" VerticalAlignment="Center" />
                      <TextBlock Text="CPU" Foreground="#eef1f3" FontSize="14" FontWeight="Bold" />
                    </DockPanel>
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Name="CpuBigVal" Text="—" Foreground="#eef1f3" FontSize="30" FontWeight="Bold" FontFamily="Consolas" />
