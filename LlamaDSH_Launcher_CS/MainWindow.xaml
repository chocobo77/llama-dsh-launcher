                </Border>
                <Border Grid.Row="0" Grid.Column="1" Background="#161a1d" CornerRadius="10" Padding="16,12" Margin="4,0,0,0" BorderBrush="#2a3036" BorderThickness="1">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                      <TextBlock DockPanel.Dock="Right" Name="MemHeadSub" Text="" FontSize="11" FontFamily="Consolas" Foreground="#8e979f" VerticalAlignment="Center" />
                      <TextBlock Text="内存" Foreground="#eef1f3" FontSize="14" FontWeight="Bold" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                      <TextBlock Name="MemBigVal" Text="—" Foreground="#eef1f3" FontSize="30" FontWeight="Bold" FontFamily="Consolas" />
                      <TextBlock Text="%" Foreground="#8e979f" FontSize="11" VerticalAlignment="Bottom" Margin="3,0,0,6" />
                      <TextBlock Name="MemUsedSub" Text="" Foreground="#8e979f" FontSize="11" FontFamily="Consolas" VerticalAlignment="Bottom" Margin="12,0,0,6" />
                    </StackPanel>
                    <Grid Height="10" Background="#1d2226">
                      <Border Name="MemStackUsed" HorizontalAlignment="Left" Width="0" Background="#34d399" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                      <Ellipse Width="8" Height="8" Fill="#34d399" VerticalAlignment="Center" /><TextBlock Name="MemLegendUsed" Text=" 已用 —" FontSize="11" FontFamily="Consolas" Foreground="#8e979f" Margin="4,0,14,0" />
                      <Ellipse Width="8" Height="8" Fill="#1d2226" Stroke="#2a3036" VerticalAlignment="Center" /><TextBlock Name="MemLegendAvail" Text=" 可用 —" FontSize="11" FontFamily="Consolas" Foreground="#8e979f" Margin="4,0,0,0" />
                    </StackPanel>
                  </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Background="#161a1d" CornerRadius="10" Padding="16,12" Margin="0,8,4,0" BorderBrush="#2a3036" BorderThickness="1">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                      <TextBlock DockPanel.Dock="Right" Name="DiskHeadSub" Text="" FontSize="11" FontFamily="Consolas" Foreground="#8e979f" VerticalAlignment="Center" />
                      <TextBlock Text="磁盘" Foreground="#eef1f3" FontSize="14" FontWeight="Bold" />
                    </DockPanel>
                    <StackPanel Name="DiskRowsHost" />
                  </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Background="#161a1d" CornerRadius="10" Padding="16,12" Margin="4,0,0,0" BorderBrush="#2a3036" BorderThickness="1">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                      <TextBlock DockPanel.Dock="Right" Name="NetHeadSub" Text="" FontSize="11" FontFamily="Consolas" Foreground="#8e979f" VerticalAlignment="Center" />
                      <TextBlock Text="网络" Foreground="#eef1f3" FontSize="14" FontWeight="Bold" />
                    </DockPanel>
                    <StackPanel Name="NetRowsHost" />
                  </StackPanel>
                </Border>
              </Grid>

              <!-- ═══ 模型与 Slot ═══ -->
              <Grid Margin="0,12,0,0">
                <TextBlock Text="模型与 Slot" Foreground="#eef1f3" FontSize="14" FontWeight="Bold" />
              </Grid>
              <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="1.4*" />
                </Grid.ColumnDefinitions>
                <Border Background="#161a1d" CornerRadius="10" Padding="16,12" Margin="0,0,4,0" BorderBrush="#2a3036" BorderThickness="1">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                      <TextBlock DockPanel.Dock="Right" Name="MiFtype" Text="" FontSize="11" Foreground="#8e979f" VerticalAlignment="Center" />
                      <TextBlock Text="模型" Foreground="#eef1f3" FontSize="14" FontWeight="Bold" />
                    </DockPanel>
                    <TextBlock Name="MiName" Text="—" Foreground="#eef1f3" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Name="MiPath" Text="路径 —" Foreground="#8e979f" FontSize="11" Margin="0,3,0,8" TextTrimming="CharacterEllipsis" />
                    <UniformGrid Columns="2">
                      <StackPanel Margin="0,3,8,3"><TextBlock Text="参数量" Foreground="#8e979f" FontSize="11" /><TextBlock Name="MiParams" Text="—" FontSize="12" /></StackPanel>
                      <StackPanel Margin="0,3,0,3"><TextBlock Text="文件体积" Foreground="#8e979f" FontSize="11" /><TextBlock Name="MiSize" Text="—" FontSize="12" /></StackPanel>
                      <StackPanel Margin="0,3,8,3"><TextBlock Text="嵌入维度" Foreground="#8e979f" FontSize="11" /><TextBlock Name="MiEmbd" Text="—" FontSize="12" /></StackPanel>
                      <StackPanel Margin="0,3,0,3"><TextBlock Text="词表大小" Foreground="#8e979f" FontSize="11" /><TextBlock Name="MiVocab" Text="—" FontSize="12" /></StackPanel>
                      <StackPanel Margin="0,3,8,3"><TextBlock Text="n_ctx" Foreground="#8e979f" FontSize="11" /><TextBlock Name="MiCtx" Text="—" FontSize="12" /></StackPanel>
                      <StackPanel Margin="0,3,0,3"><TextBlock Text="n_ctx_train" Foreground="#8e979f" FontSize="11" /><TextBlock Name="MiCtxTrain" Text="—" FontSize="12" /></StackPanel>
                      <StackPanel Margin="0,3,8,3"><TextBlock Text="vocab_type" Foreground="#8e979f" FontSize="11" /><TextBlock Name="MiVocabType" Text="—" FontSize="12" /></StackPanel>
                      <StackPanel Margin="0,3,0,3"><TextBlock Text="模态" Foreground="#8e979f" FontSize="11" /><TextBlock Name="MiModal" Text="—" FontSize="12" /></StackPanel>
                    </UniformGrid>
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#161a1d" CornerRadius="10" Padding="16,12" Margin="4,0,0,0" BorderBrush="#2a3036" BorderThickness="1">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                      <TextBlock DockPanel.Dock="Right" Name="MonSlotSummary" Text="" Foreground="#8e979f" FontSize="11" VerticalAlignment="Center" />
                      <TextBlock Text="Slot" Foreground="#eef1f3" FontSize="14" FontWeight="Bold" />
                    </DockPanel>
                    <StackPanel Name="SlotCardsHost" />
                  </StackPanel>
                </Border>
              </Grid>

              <!-- ═══ 历史趋势(实时 60s 窗口) ═══ -->
              <Grid Margin="0,12,0,0">
                <TextBlock Text="历史趋势 · 实时 60s" Foreground="#eef1f3" FontSize="14" FontWeight="Bold" />
              </Grid>
              <Border Background="#161a1d" CornerRadius="10" Padding="10" Margin="0,6,0,0" BorderBrush="#2a3036" BorderThickness="1">
                <StackPanel>
                  <TextBlock Text="llama" Foreground="#8e979f" FontSize="11" FontFamily="Consolas" Margin="4,2,0,2" />
                  <UniformGrid Columns="2">
                    <svc:TrendChart x:Name="TrendGen" Title="Token 生成速度" Unit="tok/s" Height="170" Margin="4" />
                    <svc:TrendChart x:Name="TrendPf" Title="预填充速度" Unit="tok/s" Height="170" Margin="4" />
                    <svc:TrendChart x:Name="TrendCtx" Title="上下文占用" Unit="tokens" Height="170" Margin="4" />
                    <svc:TrendChart x:Name="TrendMtp" Title="MTP 接受率" Unit="%" Height="170" Margin="4" />
                  </UniformGrid>
                  <TextBlock Text="GPU" Foreground="#8e979f" FontSize="11" FontFamily="Consolas" Margin="4,6,0,2" />
                  <UniformGrid Columns="2">
                    <svc:TrendChart x:Name="TrendGpuUtil" Title="GPU 利用率" Unit="%" Height="170" Margin="4" />
                    <svc:TrendChart x:Name="TrendGpuMem" Title="GPU 显存" Unit="GB" Height="170" Margin="4" />
                    <svc:TrendChart x:Name="TrendGpuTemp" Title="GPU 温度" Unit="°C" Height="170" Margin="4" />
                    <svc:TrendChart x:Name="TrendGpuPower" Title="GPU 功耗" Unit="W" Height="170" Margin="4" />
                  </UniformGrid>
                  <TextBlock Text="系统" Foreground="#8e979f" FontSize="11" FontFamily="Consolas" Margin="4,6,0,2" />
                  <UniformGrid Columns="2">
                    <svc:TrendChart x:Name="TrendCpu" Title="CPU" Unit="%" Height="170" Margin="4" />
                    <svc:TrendChart x:Name="TrendMem" Title="内存" Unit="GB" Height="170" Margin="4" />
                    <svc:TrendChart x:Name="TrendNet" Title="网络" Unit="MB/s" Height="170" Margin="4" />
                    <Grid Margin="4" />
                  </UniformGrid>
                </StackPanel>
              </Border>

              <!-- 熔断保护条（保护语义不变） -->
              <Border Background="#161a1d" CornerRadius="10" Padding="12,8" Margin="0,8,0,0" BorderBrush="#2a3036" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="🔒 显存熔断与启动控制位于「▶ 运行控制」区" Foreground="#8e979f" FontSize="11" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="📜 运行日志">
          <Grid Margin="8">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox Name="LogArea" Grid.Row="0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#0d1117" Foreground="#c9d1d9" FontFamily="Consolas" FontSize="11" BorderBrush="#30363d" BorderThickness="1" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
              <Button Content="🗑 清空日志" Margin="0,0,6,0" Click="ClearLog_Click" />
              <Button Content="📂 打开日志目录" Margin="0,0,10,0" Click="OpenLogDir_Click" />
              <CheckBox Name="ChkAutoScroll" Content="自动滚动" IsChecked="True" Foreground="#c9d1d9" />
            </StackPanel>
          </Grid>
        </TabItem>
      </TabControl>
    </Grid>

    <!-- 非模态提示条：替代阻塞式 MessageBox（信息类）。8s（错误 12s）后自动隐藏，也可手动关闭。 -->
    <Border Name="NoticeBar" Grid.ColumnSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
            Margin="8,0,8,8" Padding="10,8" CornerRadius="6" Panel.ZIndex="99"
            Background="#1f2937" BorderBrush="#3d444d" BorderThickness="1" Visibility="Collapsed">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="✕" Width="24" Height="22" Margin="8,0,0,0" Padding="0"
                Background="Transparent" BorderThickness="0" Foreground="#8b949e"
                ToolTip="关闭提示" Click="CloseNotice_Click" />
        <TextBlock Name="NoticeText" TextWrapping="Wrap" Foreground="#e6edf3" FontSize="12" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
  </Grid>
</Window
>