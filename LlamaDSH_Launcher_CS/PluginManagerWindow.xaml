<Window x:Class="LlamaDSH_Launcher.PluginManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🧩 DSH 插件管理" Width="880" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="#161b22" ResizeMode="CanResize">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="130" />
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,8">
      <Button Name="BtnRefresh" Content="⟳ 刷新" DockPanel.Dock="Left" Width="80" Click="Refresh_Click" />
      <TextBlock Name="TxtHeader" Text="正在检测插件状态..." Foreground="#8b949e" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
    </DockPanel>
    <ListView Grid.Row="1" Name="PluginList" Background="#0d1117" BorderBrush="#30363d" Foreground="#c9d1d9"
              SelectionChanged="PluginList_SelectionChanged"
              MouseDoubleClick="PluginList_MouseDoubleClick">
      <ListView.Resources>
        <Style TargetType="GridViewColumnHeader">
          <Setter Property="Background" Value="#161b22" />
          <Setter Property="Foreground" Value="#8b949e" />
          <Setter Property="BorderBrush" Value="#30363d" />
        </Style>
      </ListView.Resources>
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
          <Setter Property="Foreground" Value="#c9d1d9" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListViewItem">
                <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="6,3">
                  <GridViewRowPresenter Content="{TemplateBinding Content}"
                                        Columns="{TemplateBinding GridView.ColumnCollection}"
                                        TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#21262d" />
                  </Trigger>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#264f78" />
                    <Setter Property="Foreground" Value="#ffffff" />
                  </Trigger>
                  <MultiTrigger>
                    <MultiTrigger.Conditions>
                      <Condition Property="IsSelected" Value="True" />
                      <Condition Property="IsMouseOver" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter TargetName="Bd" Property="Background" Value="#2d5a8c" />
                  </MultiTrigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.View>
        <GridView>
          <GridViewColumn Header="插件" Width="230" DisplayMemberBinding="{Binding Name}" />
          <GridViewColumn Header="版本" Width="90" DisplayMemberBinding="{Binding Version}" />
          <GridViewColumn Header="状态" Width="120" DisplayMemberBinding="{Binding StateLabel}" />
          <GridViewColumn Header="依赖声明" Width="200" DisplayMemberBinding="{Binding Spec}" />
          <GridViewColumn Header="peer 问题" Width="150" DisplayMemberBinding="{Binding PeerText}" />
        </GridView>
      </ListView.View>
    </ListView>
    <WrapPanel Grid.Row="2" Margin="0,8,0,4">
      <Button Name="BtnToggle" Content="⏻ 停用并锁定" Width="120" Margin="0,0,6,0" Click="Toggle_Click" ToolTip="从 dsh.profile.bundles 移除并锁定：即使被 DSH 网页端/市场插件写回，启动器也会自动移除。再次点击为重新启用并解锁。" />
      <Button Name="BtnUpgrade" Content="⬆ 升级到最新" Width="110" Margin="0,0,6,0" Click="Upgrade_Click" ToolTip="pnpm add 插件@latest（需先停止 DSH）" />
      <Button Name="BtnExempt" Content="⚖ 版本豁免" Width="100" Margin="0,0,6,0" Click="Exempt_Click" ToolTip="为当前插件版本写入 compatibility.json 豁免（明确接受 peer 版本风险）。注意：豁免不会让构建期模块表漂移的 client 插件可用。" />
      <Button Name="BtnUninstall" Content="🗑 卸载" Width="80" Margin="0,0,6,0" Click="Uninstall_Click" ToolTip="从激活表移除并 pnpm remove 卸载插件包（需先停止 DSH）" />
      <Button Name="BtnOpenDir" Content="📁 打开目录" Width="96" Click="OpenDir_Click" />
      <Button Name="BtnInstallLocal" Content="📦 安装本地插件" Width="140" Margin="8,0,0,0" Click="InstallLocal_Click" ToolTip="从本地目录（自动打包为 tgz）或 .tgz 安装任意插件；安装后若声明 dsh.bundle 会自动加入 profile。需先停止 DSH。" />
    </WrapPanel>
    <TextBox Grid.Row="3" Name="MgrLog" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
             Background="#0d1117" Foreground="#c9d1d9" FontFamily="Consolas" FontSize="11"
             BorderBrush="#30363d" BorderThickness="1" Margin="0,4,0,0" />
  </Grid>
</Window>
